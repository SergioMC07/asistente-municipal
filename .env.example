# Clave de OpenAI (obligatoria para generar fichas y para el chat)
OPENAI_API_KEY=

# Modelos (opcionales)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_FICHA_MODEL=gpt-4.1-mini

# URL pública de las demos (para imprimir el enlace al generar una demo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contacto que aparece en la portada y en el pie de las demos
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp del comercial, con prefijo de país (botón "Ponerlo en marcha")
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Número de WhatsApp del asistente de demostración (botón "Probar en WhatsApp")
NEXT_PUBLIC_WHATSAPP_DEMO_NUMBER=

# Aviso al móvil cuando alguien abre una demo o escribe su primer mensaje.
# Instala la app ntfy, suscríbete a un tema secreto y pon aquí su URL:
# NOTIFY_URL=https://ntfy.sh/atiende-<algo-dificil-de-adivinar>
NOTIFY_URL=

# Datos del titular para el aviso legal (LSSI)
NEXT_PUBLIC_TITULAR_NOMBRE=
NEXT_PUBLIC_TITULAR_NIF=
NEXT_PUBLIC_TITULAR_DOMICILIO=

# Citas reales (opcional). Sin esto, todas las agendas funcionan en modo demo.
# Supabase → Settings → API: Project URL y la clave service_role (secreta, solo servidor).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Avisos por email de cada cita al negocio (resend.com). AVISOS_FROM debe ser de un dominio verificado.
RESEND_API_KEY=
AVISOS_FROM=
